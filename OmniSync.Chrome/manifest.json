{
  "manifest_version": 3,
  "name": "OmniSync Browser Controller",
  "version": "1.2",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "history",
    "contextMenus",
    "alarms",
    "management"
  ],
  "action": {
    "default_icon": {
      "16": "icons/omni.png",
      "32": "icons/omni.png",
      "48": "icons/omni.png",
      "128": "icons/omni.png"
    },
    "default_popup": "browser-popup.html"
  },
  "icons": {
    "16": "icons/omni.png",
    "32": "icons/omni.png",
    "48": "icons/omni.png",
    "128": "icons/omni.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*/*"
  ]
}
