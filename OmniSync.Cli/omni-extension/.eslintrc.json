{
  "plugins": ["html"],
  "env": {
    "browser": true,
    "es2021": true,
    "node": true
  },
  "globals": {
    "THREE": "readonly",
    "CANNON": "readonly",
    "OrbitControls": "readonly"
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "no-undef": "error",
    "no-unused-vars": "warn"
  }
}
