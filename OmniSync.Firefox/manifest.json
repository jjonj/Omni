{
  "manifest_version": 2,
  "name": "OmniSync Firefox",
  "version": "1.0",
  "description": "A collection of tools for website interaction.",
  "browser_specific_settings": {
    "gecko": {
      "id": "omnisync-firefox@croves.me",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "description": "This add-on does not collect any personal or technical data.",
        "origins": [],
        "uses_user_id": false,
        "uses_device_id": false,
        "uses_other_data": false,
        "data_categories": {
          "personal_data": {
            "collected": false,
            "shared": false
          },
          "technical_data": {
            "collected": false,
            "shared": false
          }
        }
      }
    }
  },
  "permissions": [
    "tabs",
    "storage"
  ],
  "background": {
    "scripts": ["signalr.min.js", "background.js"]
  },
  "browser_action": {
    "default_icon": {
      "48": "icons/unmuted.svg"
    },
    "default_title": "OmniSync Actions"
  },
  "icons": {
    "48": "icons/omni.png",
    "128": "icons/omni.png"
  }
}
