{
  "manifest_version": 2,
  "name": "FireCroves",
  "version": "1.0",
  "description": "A collection of tools for website interaction.",
  "permissions": [
    "tabs",
    "storage"
  ],
  "background": {
    "scripts": ["signalr.min.js", "background.js"]
  },
  "browser_action": {
    "default_icon": {
      "48": "icons/unmuted.svg"
    },
    "default_title": "FireCroves Actions"
  },
  "icons": {
    "48": "icons/icon.svg"
  }
}
