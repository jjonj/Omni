<Window x:Class="OmniSync.Hub.Presentation.OmniSweepWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OmniSync.Hub.Presentation"
        Title="OmniSweep" Width="790" Height="580" MinWidth="500" MinHeight="350"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" Topmost="True" ShowInTaskbar="False" ShowActivated="True"
        KeyboardNavigation.TabNavigation="Cycle"
        Deactivated="Window_Deactivated" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <local:CalendarEventDateConverter x:Key="CalendarEventDateConverter"/>
        <local:CalendarEventEndConverter x:Key="CalendarEventEndConverter"/>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#343B48"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="4"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Width" Value="224"/><Setter Property="Height" Value="112"/>
            <Setter Property="Margin" Value="5"/><Setter Property="Padding" Value="12"/>
            <Setter Property="Background" Value="#282E39"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="TileBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                            CornerRadius="8" BorderBrush="#414B5B" BorderThickness="1">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="TileBorder" Property="BorderBrush" Value="#67B8FF"/><Setter TargetName="TileBorder" Property="Background" Value="#35435B"/></Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="TileBorder" Property="BorderThickness" Value="2"/></Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TileBorder" Property="BorderBrush" Value="#8CAED5"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Background="#20252F" BorderBrush="#576579" BorderThickness="1" CornerRadius="12" Padding="18">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel>
            <Border Background="#2B3340" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding OngoingEvents.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="ONGOING EVENTS" FontSize="10" FontWeight="Bold"
                               Foreground="#9EE2A8" VerticalAlignment="Top" Margin="0,3,15,0"/>
                    <ItemsControl Grid.Column="1" ItemsSource="{Binding OngoingEvents}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,1">
                                    <TextBlock DockPanel.Dock="Right" Foreground="#AAB6C9" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <Run Text="ENDS "/>
                                        <Run Text="{Binding Path=., Mode=OneWay, Converter={StaticResource CalendarEventEndConverter}}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" Foreground="White"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
            <Border Background="#282E39" CornerRadius="8" Padding="12,10" Margin="0,0,0,10"
                    Visibility="{Binding NextEvent, Converter={StaticResource NullToVisibilityConverter}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="NEXT EVENT" FontSize="10" FontWeight="Bold" Foreground="#89C9FF" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding NextEvent.Start, Converter={StaticResource CalendarEventDateConverter}}" Foreground="#AAB6C9" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding NextEvent.Summary}" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Text="OmniSweep" Foreground="White" FontSize="25" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button DockPanel.Dock="Right" Content="Snapshot" Command="{Binding SnapshotCommand}"/>
                <Button DockPanel.Dock="Right" Content="Search /" Click="Search_Click"/>
            </DockPanel>
            </StackPanel>
            <TextBox Grid.Row="1" x:Name="SearchInput" Visibility="Collapsed" Margin="5,12,5,8" Padding="10"
                     Background="#303847" Foreground="White" FontSize="16"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search setups, macros and files"/>
            <Grid Grid.Row="2" Margin="0,12,0,12">
                <ListBox x:Name="ResultsList" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedItem}"
                         Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         KeyboardNavigation.TabNavigation="Once" AllowDrop="True" PreviewMouseLeftButtonDown="Tile_MouseDown"
                         PreviewMouseMove="Tile_MouseMove" Drop="Tile_Drop" ContextMenuOpening="Tile_ContextMenuOpening"
                         PreviewMouseLeftButtonUp="Tile_MouseUp" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                    <ListBox.ItemTemplate><DataTemplate>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <Grid>
                                    <TextBlock x:Name="TileNameLabel" Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="52"/>
                                    <TextBox x:Name="TileNameEditor" Visibility="Collapsed" FontSize="16" FontWeight="SemiBold"
                                             Background="#303847" Foreground="White" BorderBrush="#67B8FF" Padding="3,1"
                                             TextWrapping="Wrap" MaxHeight="65" VerticalContentAlignment="Center"
                                             PreviewKeyDown="TileNameEditor_PreviewKeyDown" LostKeyboardFocus="TileNameEditor_LostKeyboardFocus"/>
                                </Grid>
                                <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="#AAB6C9" Margin="0,7,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding Shortcut}" Foreground="#89C9FF" FontSize="22" FontWeight="Bold" Margin="10,0,0,0" MaxWidth="90" TextWrapping="Wrap"/>
                        </Grid>
                    </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="{Binding EmptyMessage}" Foreground="#AAB6C9" TextWrapping="Wrap" TextAlignment="Center"
                           HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="400" IsHitTestVisible="False">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers><DataTrigger Binding="{Binding Results.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                    </Style></TextBlock.Style>
                </TextBlock>
            </Grid>
            <Border Grid.Row="3" BorderBrush="#414B5B" BorderThickness="0,1,0,0" Padding="0,10,0,6">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Scenes.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="SCENES" Foreground="#89C9FF" FontSize="10" FontWeight="Bold" Margin="4,0,0,5"/>
                    <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="SceneButtons" ItemsSource="{Binding Scenes}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Title}" ToolTip="{Binding Title, StringFormat=Activate {0}}"
                                            Command="{Binding DataContext.ExecuteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>
            <TextBlock Grid.Row="4" Foreground="#AAB6C9" Text="WASD / arrows · Space to open · / to search · Right-click to edit · Drag to reorder" FontSize="11" TextWrapping="Wrap"/>
        </Grid>
    </Border>
</Window>
