        },
        "route": {
          "$ref": "#/$defs/route"
        },
        "label": {
          "$ref": "#/$defs/label"
        },
        "style": {
          "$ref": "#/$defs/style"
        },
        "semantic": {
          "$ref": "#/$defs/semantic"
        }
      },
      "required": [
        "id",
        "type",
        "layerId",
        "parentId",
        "order",
        "source",
        "target",
        "route"
      ],
      "additionalProperties": false
    },
    "nodeContent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "chips"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "subtitle": {
