        "layerId": {
          "type": "string",
          "pattern": "^lyr_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "parentId": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^el_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "locked": {
          "type": "boolean"
        },
        "hidden": {
          "type": "boolean"
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        },
        "type": {
          "const": "edge"
        },
        "source": {
          "$ref": "#/$defs/endpoint"
        },
        "target": {
