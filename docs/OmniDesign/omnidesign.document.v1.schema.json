{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:omnidesign:document:v1",
  "title": "OmniDesign native editable document v1",
  "description": "Authoritative interchange contract. Root revision is Hub-assigned; pending local edits live in a separate device journal.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schemaVersion",
    "id",
    "revision",
    "title",
    "family",
    "metadata",
    "page",
    "theme",
    "layers",
    "elements",
    "libraries",
    "assets"
  ],
  "properties": {
    "format": {
      "const": "omnidesign"
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^dgm_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "family": {
      "enum": [
        "architecture",
        "flowchart",
        "sequence",
        "state",
        "erd",
        "network",
        "roadmap",
        "floorplan",
        "swimlane",
        "mindmap",
        "game-system",
        "custom"
      ]
    },
    "metadata": {
      "type": "object",
      "properties": {
        "createdAt": {
          "$ref": "#/$defs/date"
        },
        "updatedAt": {
          "$ref": "#/$defs/date"
        },
        "originDeviceId": {
          "type": "string",
          "pattern": "^dev_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "forkedFrom": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^dgm_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                },
                "revision": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "id",
                "revision"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "description": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "createdAt",
        "updatedAt",
        "originDeviceId",
        "forkedFrom"
      ],
      "additionalProperties": false
    },
    "page": {
      "type": "object",
      "properties": {
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "background": {
          "type": "string"
        },
        "grid": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "size": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "snap": {
              "type": "boolean"
            }
          },
          "required": [
            "enabled",
            "size",
            "snap"
          ],
          "additionalProperties": false
        },
        "units": {
          "enum": [
            "px",
            "mm"
          ]
        }
      },
      "required": [
        "width",
        "height",
        "background",
        "grid",
        "units"
      ],
      "additionalProperties": false
    },
    "theme": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "tokens": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "name",
        "tokens"
      ],
      "additionalProperties": false
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^lyr_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "name": {
            "type": "string"
          },
          "visible": {
            "type": "boolean"
          },
          "locked": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "visible",
          "locked"
        ],
        "additionalProperties": false
      }
    },
    "elements": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/node"
          },
          {
            "$ref": "#/$defs/group"
          },
          {
            "$ref": "#/$defs/textElement"
          },
          {
            "$ref": "#/$defs/path"
          },
          {
            "$ref": "#/$defs/edge"
          }
        ]
      }
    },
    "libraries": {
      "type": "object",
      "properties": {
        "references": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "version": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "version"
            ],
            "additionalProperties": false
          }
        },
        "embedded": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "shapes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "fallback": {
                      "enum": [
                        "rect",
                        "roundRect",
                        "ellipse",
                        "diamond",
                        "line",
                        "polygon",
                        "icon"
                      ]
                    },
                    "defaultStyle": {
                      "$ref": "#/$defs/style"
                    },
                    "defaultPorts": {
                      "type": "array",
                      "items": {
                        "$ref": "#/$defs/portTemplate"
                      }
                    }
                  },
                  "required": [
                    "name",
                    "fallback"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "id",
              "version",
              "name",
              "shapes"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "references",
        "embedded"
      ],
      "additionalProperties": false
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^ast_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "mimeType": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "byteLength": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "id",
          "mimeType",
          "sha256",
          "byteLength"
        ],
        "additionalProperties": false
      }
    },
    "extensions": {
      "$ref": "#/$defs/extensions"
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "format": "date-time"
    },
    "extensions": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": true,
      "propertyNames": {
        "pattern": "^[A-Za-z0-9._-]+/[A-Za-z0-9._/-]+$"
      }
    },
    "point": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false
    },
    "geometry": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "rotation": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height",
        "rotation"
      ],
      "additionalProperties": false
    },
    "anchor": {
      "type": "object",
      "properties": {
        "side": {
          "enum": [
            "top",
            "right",
            "bottom",
            "left",
            "center"
          ]
        },
        "t": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "side",
        "t"
      ],
      "additionalProperties": false
    },
    "style": {
      "type": "object",
      "properties": {
        "fill": {
          "type": "string"
        },
        "stroke": {
          "type": "string"
        },
        "strokeWidth": {
          "type": "number",
          "minimum": 0
        },
        "strokeDash": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "cornerRadius": {
          "type": "number",
          "minimum": 0
        },
        "textColor": {
          "type": "string"
        },
        "fontFamily": {
          "type": "string"
        },
        "fontSize": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "fontWeight": {
          "type": "integer",
          "minimum": 100,
          "maximum": 900
        },
        "textAlign": {
          "enum": [
            "left",
            "center",
            "right"
          ]
        },
        "lineHeight": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "tokenRefs": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "semantic": {
      "type": "object",
      "properties": {
        "role": {
          "type": "string"
        },
        "data": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "required": [
        "role",
        "data"
      ],
      "additionalProperties": false
    },
    "label": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "style": {
          "$ref": "#/$defs/style"
        }
      },
      "required": [
        "text"
      ],
      "additionalProperties": false
    },
    "portTemplate": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "direction": {
          "enum": [
            "in",
            "out",
            "both"
          ]
        },
        "dataType": {
          "type": "string"
        },
        "anchor": {
          "$ref": "#/$defs/anchor"
        }
      },
      "required": [
        "name",
        "direction",
        "anchor"
      ],
      "additionalProperties": false
    },
    "port": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^prt_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "name": {
          "type": "string"
        },
        "direction": {
          "enum": [
            "in",
            "out",
            "both"
          ]
        },
        "dataType": {
          "type": "string"
        },
        "anchor": {
          "$ref": "#/$defs/anchor"
        }
      },
      "required": [
        "id",
        "name",
        "direction",
        "anchor"
      ],
      "additionalProperties": false
    },
    "shape": {
      "type": "object",
      "properties": {
        "libraryId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "fallback": {
          "enum": [
            "rect",
            "roundRect",
            "ellipse",
            "diamond",
            "line",
            "polygon",
            "icon"
          ]
        }
      },
      "required": [
        "libraryId",
        "name",
        "version",
        "fallback"
      ],
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^el_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "layerId": {
          "type": "string",
          "pattern": "^lyr_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "parentId": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^el_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "locked": {
          "type": "boolean"
        },
        "hidden": {
          "type": "boolean"
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        },
        "type": {
          "const": "node"
        },
        "geometry": {
          "$ref": "#/$defs/geometry"
        },
        "shape": {
          "$ref": "#/$defs/shape"
        },
        "ports": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/port"
          }
        },
        "label": {
          "$ref": "#/$defs/label"
        },
        "style": {
          "$ref": "#/$defs/style"
        },
        "semantic": {
          "$ref": "#/$defs/semantic"
        },
        "content": {
          "$ref": "#/$defs/nodeContent"
        }
      },
      "required": [
        "id",
        "type",
        "layerId",
        "parentId",
        "order",
        "geometry",
        "shape",
        "ports"
      ],
      "additionalProperties": false
    },
    "group": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^el_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "layerId": {
          "type": "string",
          "pattern": "^lyr_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "parentId": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^el_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "locked": {
          "type": "boolean"
        },
        "hidden": {
          "type": "boolean"
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        },
        "type": {
          "const": "group"
        },
        "geometry": {
          "$ref": "#/$defs/geometry"
        },
        "label": {
          "$ref": "#/$defs/label"
        },
        "style": {
          "$ref": "#/$defs/style"
        },
        "semantic": {
          "$ref": "#/$defs/semantic"
        }
      },
      "required": [
        "id",
        "type",
        "layerId",
        "parentId",
        "order",
        "geometry"
      ],
      "additionalProperties": false
    },
    "textElement": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^el_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "layerId": {
          "type": "string",
          "pattern": "^lyr_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "parentId": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^el_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "locked": {
          "type": "boolean"
        },
        "hidden": {
          "type": "boolean"
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        },
        "type": {
          "const": "text"
        },
        "geometry": {
          "$ref": "#/$defs/geometry"
        },
        "text": {
          "type": "string"
        },
        "style": {
          "$ref": "#/$defs/style"
        },
        "semantic": {
          "$ref": "#/$defs/semantic"
        }
      },
      "required": [
        "id",
        "type",
        "layerId",
        "parentId",
        "order",
        "geometry",
        "text"
      ],
      "additionalProperties": false
    },
    "path": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^el_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "layerId": {
          "type": "string",
          "pattern": "^lyr_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "parentId": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^el_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "locked": {
          "type": "boolean"
        },
        "hidden": {
          "type": "boolean"
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        },
        "type": {
          "const": "path"
        },
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "op": {
                    "enum": [
                      "M",
                      "L"
                    ]
                  },
                  "to": {
                    "$ref": "#/$defs/point"
                  }
                },
                "required": [
                  "op",
                  "to"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "op": {
                    "const": "C"
                  },
                  "control1": {
                    "$ref": "#/$defs/point"
                  },
                  "control2": {
                    "$ref": "#/$defs/point"
                  },
                  "to": {
                    "$ref": "#/$defs/point"
                  }
                },
                "required": [
                  "op",
                  "control1",
                  "control2",
                  "to"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "op": {
                    "const": "Z"
                  }
                },
                "required": [
                  "op"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "style": {
          "$ref": "#/$defs/style"
        },
        "semantic": {
          "$ref": "#/$defs/semantic"
        }
      },
      "required": [
        "id",
        "type",
        "layerId",
        "parentId",
        "order",
        "commands"
      ],
      "additionalProperties": false
    },
    "endpoint": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "port"
            },
            "nodeId": {
              "type": "string",
              "pattern": "^el_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            "portId": {
              "type": "string",
              "pattern": "^prt_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            }
          },
          "required": [
            "type",
            "nodeId",
            "portId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "anchor"
            },
            "nodeId": {
              "type": "string",
              "pattern": "^el_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            "anchor": {
              "$ref": "#/$defs/anchor"
            }
          },
          "required": [
            "type",
            "nodeId",
            "anchor"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "free"
            },
            "point": {
              "$ref": "#/$defs/point"
            }
          },
          "required": [
            "type",
            "point"
          ],
          "additionalProperties": false
        }
      ]
    },
    "route": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "orthogonal",
            "straight",
            "bezier"
          ]
        },
        "waypoints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/point"
          }
        },
        "manual": {
          "type": "boolean"
        }
      },
      "required": [
        "mode",
        "waypoints",
        "manual"
      ],
      "additionalProperties": false
    },
    "edge": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^el_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
